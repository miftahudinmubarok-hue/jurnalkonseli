# GEMINI_API_KEY: Wajib untuk analisis mingguan AI Gemini oleh konselor.
# Diinjeksi otomatis oleh AI Studio dari Secrets pengguna.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL aplikasi yang dihosting.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Client ID Google OAuth (Google Sign-In Web).
# Didapatkan dari Google Cloud Console -> APIs & Services -> Credentials.
GOOGLE_CLIENT_ID=""

# ADMIN_EMAIL: Alamat email admin konseling untuk mengelola daftar konselor.
ADMIN_EMAIL="MiftahudinMubarok@gmail.com"

# DRIVE_ROOT_FOLDER_ID: ID folder Google Drive milik lembaga/admin konseling tempat menyimpan seluruh data.
DRIVE_ROOT_FOLDER_ID=""

# SERVICE_ACCOUNT_JSON: Konten JSON kredensial Google Service Account dengan akses Editor ke folder Drive di atas.
SERVICE_ACCOUNT_JSON=""
